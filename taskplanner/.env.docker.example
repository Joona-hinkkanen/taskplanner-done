# Kopioi tämä tiedostoksi .env (samassa kansiossa kuin docker-compose.yml),
# jos haluat vaihtaa oletusarvot. Tiedostoa .env EI committoida.
# Ilman .env-tiedostoa docker-compose.yml käyttää sisäänrakennettuja oletuksia.

SECRET_KEY=vaihda-tama-pitkaan-satunnaiseen-arvoon
DEBUG=False
ALLOWED_HOSTS=localhost 127.0.0.1 0.0.0.0

# Tietokanta (luodaan automaattisesti db-palveluun)
DB_NAME=taskplanner
DB_USER=taskplanner
DB_PASSWORD=taskplanner

# Pääkäyttäjä luodaan kontin käynnistyessä
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
